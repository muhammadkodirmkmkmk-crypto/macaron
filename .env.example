# ============ ОБЯЗАТЕЛЬНО ============

# 1) Токен бота из @BotFather
TELEGRAM_BOT_TOKEN=1234567890:AAF...

# 2) Ключ Anthropic (console.anthropic.com -> API keys) — распознаёт номер сушки с фото
ANTHROPIC_API_KEY=sk-ant-api03-...

# ============ ЖЕЛАТЕЛЬНО ============

# ID группы. Узнать: добавить бота в группу и написать /id
# Пусто = бот слушает любую группу, куда его добавят.
ALLOWED_CHAT_IDS=-1001234567890

# Пароль на дашборд (пусто = открыт всем, у кого есть ссылка)
DASHBOARD_PASSWORD=makaron2026

# Публичный адрес дашборда — бот подставляет его в отчёты
PUBLIC_URL=https://makaron-analytics.up.railway.app

# ============ НАСТРОЙКИ ============

DRYER_COUNT=31
TZ=Asia/Tashkent

# Принимать отчёты и вопросы в личке с ботом (1 = да)
PRIVATE_ENABLED=1
# Кто может писать боту в личку. Пусто = любой. ID узнать командой /id
ALLOWED_USER_IDS=2020346135,7871931220

# Ассистент: свободные вопросы в личке («дай отчёт по 7-й сушке за неделю»)
ASSISTANT_ENABLED=1
ASSISTANT_MODEL=claude-haiku-4-5
# Если основная модель перегружена (HTTP 529) — уходим на запасную
ASSISTANT_FALLBACK_MODEL=claude-haiku-4-5

# Модель для распознавания фото.
# Замер на реальных снимках табло МПР-49 (4 фото x 3 прогона):
#   claude-haiku-4-5    номер 12/12, t 12/12, влажность 12/12   ~$0.0018 за фото
#   claude-sonnet-4-5   номер 12/12, t  9/12, влажность 12/12   ~$0.0054 за фото
#   claude-sonnet-5     номер 12/12, t  6/12, влажность 12/12
# Haiku и точнее, и дешевле — он по умолчанию.
ANTHROPIC_MODEL=claude-haiku-4-5
# VISION_ENABLED=0   # выключить распознавание фото (экономия)

# Норма времени сушки в минутах — вне диапазона бот пишет предупреждение
NORM_MIN_MINUTES=360
NORM_MAX_MINUTES=960

# Час утреннего автоотчёта в группу (локальное время). -1 = выключить
DAILY_REPORT_HOUR=8

# Заложили партию («00:28 kirdi») и молчат — через столько часов бот
# напомнит в группу реплаем на исходное сообщение. 0 в LOAD_REMINDER_ENABLED — выключить
LOAD_REMINDER_HOURS=10
LOAD_REMINDER_ENABLED=1

# Через сколько часов молчания считать сушку «замолчавшей»
STALE_HOURS=24

# Окно защиты от дублей в минутах: тот же отчёт из группы и из лички
# в пределах этого времени считается одним
DUP_WINDOW_MINUTES=20

# Список продуктов через запятую (пусто = встроенный список)
# PRODUCTS=Burama,Pero,Pautinka,Spiral,Rojok,Vermishel

# Postgres на Railway подставится сам. Локально — SQLite в ./data
# DATABASE_URL=postgresql://user:pass@host:5432/db
