# ============ ОБЯЗАТЕЛЬНО ============

# 1) Токен бота из @BotFather
TELEGRAM_BOT_TOKEN=1234567890:AAF...

# 2) Ключ Anthropic (console.anthropic.com -> API keys) — распознаёт номер сушки с фото
ANTHROPIC_API_KEY=sk-ant-api03-...

# ============ ЖЕЛАТЕЛЬНО ============

# ID группы. Узнать: добавить бота в группу и написать /id
# Пусто = бот слушает любую группу, куда его добавят.
ALLOWED_CHAT_IDS=-1001234567890

# Пароль на дашборд (пусто = открыт всем, у кого есть ссылка)
DASHBOARD_PASSWORD=makaron2026

# Публичный адрес дашборда — бот подставляет его в отчёты
PUBLIC_URL=https://makaron-analytics.up.railway.app

# ============ НАСТРОЙКИ ============

DRYER_COUNT=31
TZ=Asia/Tashkent

# Модель для распознавания фото
ANTHROPIC_MODEL=claude-sonnet-4-5
# VISION_ENABLED=0   # выключить распознавание фото (экономия)

# Норма времени сушки в минутах — вне диапазона бот пишет предупреждение
NORM_MIN_MINUTES=360
NORM_MAX_MINUTES=960

# Час утреннего автоотчёта в группу (локальное время). -1 = выключить
DAILY_REPORT_HOUR=8

# Через сколько часов молчания считать сушку «замолчавшей»
STALE_HOURS=24

# Список продуктов через запятую (пусто = встроенный список)
# PRODUCTS=Burama,Pero,Pautinka,Spiral,Rojok,Vermishel

# Postgres на Railway подставится сам. Локально — SQLite в ./data
# DATABASE_URL=postgresql://user:pass@host:5432/db
